<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Template: __HOME__ is replaced by ops/install_launchd.sh. Hours are the Mac's local time, which is KST here (install script refuses otherwise). -->
<plist version="1.0">
<dict>
